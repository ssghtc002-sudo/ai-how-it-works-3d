  "dialogue": [
    {
      "id": "line_01",
      "beatId": "beat_1_data_tokens",
      "speaker": "narrator",
      "start": 0.25,
      "end": 4.85,
      "text": "AI doesn't think like us—it turns messy words and pixels into math."
    },
    {
      "id": "line_02",
      "beatId": "beat_2_neural_layers",
      "speaker": "narrator",
      "start": 5.15,
      "end": 10.00,
      "text": "Inside its neural network, millions of connected weights pass signals layer by layer."
    },
    {
      "id": "line_03",
      "beatId": "beat_3_attention_context",
      "speaker": "narrator",
      "start": 10.35,
      "end": 15.20,
      "text": "Attention layers compare every token at once, locking onto hidden patterns and context."
    },
    {
      "id": "line_04",
      "beatId": "beat_4_training_backprop",
      "speaker": "narrator",
      "start": 15.55,
      "end": 20.40,
      "text": "During training, it guesses, checks the error, and tunes those weights backward."
    },
    {
      "id": "line_05",
      "beatId": "beat_5_probability_output",
      "speaker": "narrator",
      "start": 20.75,
      "end": 25.60,
      "text": "When generating an answer, it scores every option and picks the best match."
    },
    {
      "id": "line_06",
      "beatId": "beat_6_intelligence_recap",
      "speaker": "narrator",
      "start": 25.95,
      "end": 29.75,
      "text": "Scale data and math together—and patterns start acting like intelligence."
    }
  ],
